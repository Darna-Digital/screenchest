{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenchest-www",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "screenchest.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
